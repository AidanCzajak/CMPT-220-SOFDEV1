import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);
        factorial(scanner);
        everyOtherSum(scanner);
        reverseString(scanner);

   }
    public static void factorial(Scanner scanner) {

        System.out.println("Problem 2");
          System.out.println("Enter a number and I will tell you the factorial:");

          int num = scanner.nextInt();
          int fact = 1;

        for (int i = 1; i <= num; i++) {
            fact *= i;
   }

        System.out.println("Factorial: " + fact);
    }

    public static void everyOtherSum(Scanner scanner) {

        System.out.println("Problem 3");
          System.out.println("Enter a number and I will tell you the sum of every other number:");

        int num = scanner.nextInt();
        int sum = 0;

        for (int i = 1; i <= num; i += 2) {
            sum += i;
        }

        System.out.println("Sum: " + sum);
}

      public static void reverseString(Scanner scanner)   {

        scanner.nextLine(); // clears leftover newline

            System.out.println("Problem 5");
          System.out.println("Enter a word or sentence:");

        String input = scanner.nextLine();
        String reverse = "";

        for (int i = input.length() - 1; i >= 0; i--) {
            reverse += input.charAt(i);
  }

        System.out.println("Reversed: " + reverse);
    }
    }
